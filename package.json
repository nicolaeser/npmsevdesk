{
  "name": "npmsevdesk",
  "version": "0.1.1",
  "description": "Unofficial TypeScript Axios client for the sevdesk API.",
  "keywords": [
    "sevdesk",
    "api",
    "sdk",
    "axios",
    "typescript",
    "invoicing",
    "accounting"
  ],
  "author": "Nico Laeser",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicolaeser/npmsevdesk.git"
  },
  "homepage": "https://github.com/nicolaeser/npmsevdesk",
  "bugs": {
    "url": "https://github.com/nicolaeser/npmsevdesk/issues"
  },
  "packageManager": "npm@11.17.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.5.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "CLAUDE.md",
    ".ai",
    "!.ai/.backup"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/esm/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/types/cjs/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./raw": {
      "import": {
        "types": "./dist/types/esm/raw.d.ts",
        "default": "./dist/raw.js"
      },
      "require": {
        "types": "./dist/types/cjs/raw.d.cts",
        "default": "./dist/raw.cjs"
      }
    },
    "./types": {
      "import": {
        "types": "./dist/types/esm/types-entry.d.ts",
        "default": "./dist/types.js"
      },
      "require": {
        "types": "./dist/types/cjs/types-entry.d.cts",
        "default": "./dist/types.cjs"
      }
    },
    "./enums": {
      "import": {
        "types": "./dist/types/esm/enums-entry.d.ts",
        "default": "./dist/enums.js"
      },
      "require": {
        "types": "./dist/types/cjs/enums-entry.d.cts",
        "default": "./dist/enums.cjs"
      }
    },
    "./bundles": {
      "import": {
        "types": "./dist/types/esm/bundles-entry.d.ts",
        "default": "./dist/bundles.js"
      },
      "require": {
        "types": "./dist/types/cjs/bundles-entry.d.cts",
        "default": "./dist/bundles.cjs"
      }
    },
    "./taxes": {
      "import": {
        "types": "./dist/types/esm/taxes-entry.d.ts",
        "default": "./dist/taxes.js"
      },
      "require": {
        "types": "./dist/types/cjs/taxes-entry.d.cts",
        "default": "./dist/taxes.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "verify:release": "node .github/scripts/verify-release.mjs",
    "build": "tsup && npm run build:types",
    "build:types": "node .github/scripts/build-cjs-declarations.mjs --clean && tsc -p tsconfig.build.json && node .github/scripts/build-cjs-declarations.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:examples": "tsc -p examples/tsconfig.json",
    "test": "vitest run",
    "test:live:read": "vitest run --fileParallelism false --maxWorkers 1 --testTimeout 60000 --hookTimeout 60000 test/read-only.live.ts",
    "test:live:write": "vitest run --fileParallelism false --maxWorkers 1 --testTimeout 60000 --hookTimeout 60000 test/write.live.ts",
    "verify:package": "node .github/scripts/verify-package-exports.mjs",
    "check": "npm run typecheck && npm run typecheck:examples && npm run test && npm run build && npm run verify:package && publint",
    "prepack": "npm run build && npm run verify:package",
    "prepublishOnly": "npm run verify:release && npm run check"
  },
  "dependencies": {
    "axios": "^1.19.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "publint": "^0.3.22",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "undici": "^6.28.0"
  }
}
